          "${OD_CSS2_BASE_URL}/transporter/transport-events/vc/delivery-shipment1.jsonld",
          "${OD_CSS2_BASE_URL}/transporter/transport-events/vc/pickup-shipment3.jsonld",
          "${OD_CSS2_BASE_URL}/transporter/transport-events/vc/delivery-shipment3.jsonld",
          "${OD_CSS3_BASE_URL}/retailer/shipments/in/vc/receipt-shipment3.jsonld"
