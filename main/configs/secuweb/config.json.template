{
  "title": "Query the SecuWeb Food Supply Chain",
  "logoLocation": "images/IDLab-logo.png",
  "logoRedirectURL": "https://idlab.technology/",
  "mainAppColor": "lightgray",
  "backgroundColor": "#fff",
  "titleColor": "black",
  "textColor": "#1976D2",
  "queryFolder": "queries",
  "showMilliseconds": false,
  "defaultIDP": "${OD_CSS0_BASE_URL}/",
  "footer": "<p><a href='https://idlab.technology/'>IDLab</a> - <a href='https://www.imec.be/nl'>imec</a> - <a href='https://www.ugent.be/'>UGent</a></p>",
  "introductionText": "Please log in as the appropriate actor and select a query from the menu on the left.",
  "features": {
    "verification": {
      "vc": true,
      "onchain": true
    }
  },

  "queryGroups": [
    {
      "id": "farmer",
      "name": "Farmer",
      "icon": "InfoIcon"
    },
    {
      "id": "transporter",
      "name": "Transporter",
      "icon": "LocalShippingIcon"
    },
    {
      "id": "packager",
      "name": "Packager",
      "icon": "Inventory2Icon"
    },
    {
      "id": "retailer",
      "name": "Retailer",
      "icon": "StorefrontIcon"
    },
    {
      "id": "discovery",
      "name": "Discovery",
      "icon": "ListAltIcon"
    }
  ],
  "queries": [
    {
      "id": "0",
      "queryLocation": "spo.rq",
      "name": "SPO (all actors)",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment2.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-x.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-y.jsonld",
          "${OD_CSS0_BASE_URL}/packager/products/vc/packaged-batch-001.jsonld",
          "${OD_CSS0_BASE_URL}/packager/shipments/out/vc/shipment3.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/pickup-shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/delivery-shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/pickup-shipment3.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/delivery-shipment3.jsonld",
          "${OD_CSS0_BASE_URL}/retailer/shipments/in/vc/receipt-shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "1",
      "queryLocation": "products.rq",
      "name": "Products (Farmer + Packager)",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-x.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-y.jsonld",
          "${OD_CSS0_BASE_URL}/packager/products/vc/packaged-batch-001.jsonld",
          "${OD_CSS0_BASE_URL}/packager/shipments/out/vc/shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "2",
      "queryLocation": "spo.rq",
      "name": "Catalog-discovered data",
      "description": "Queries actor resources discovered dynamically through the consortium catalog.",
      "sourcesIndex": {
        "url": "${OD_CSS0_BASE_URL}/consortium/catalog/index.jsonld",
        "queryLocation": "sourceQueries/seeAlso.rq"
      }
    },
    {
      "id": "201",
      "queryGroupId": "discovery",
      "queryLocation": "transport-companies.rq",
      "name": "Transport companies",
      "description": "Discovers transport actors and their service endpoints from the consortium catalog.",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/consortium/catalog/index.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "202",
      "queryGroupId": "discovery",
      "queryLocation": "catalog-sources.rq",
      "name": "Catalog sources",
      "description": "Discovers the distinct resource URLs published by the consortium catalog.",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/consortium/catalog/index.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "101",
      "queryGroupId": "farmer",
      "queryLocation": "shipments.rq",
      "name": "Farmer: shipments & product facts",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment2.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-x.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-y.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "102",
      "queryGroupId": "transporter",
      "queryLocation": "shipments.rq",
      "name": "Transporter: transport events",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/pickup-shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/delivery-shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/pickup-shipment3.jsonld",
          "${OD_CSS0_BASE_URL}/transporter/transport-events/vc/delivery-shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "103",
      "queryGroupId": "packager",
      "queryLocation": "shipments.rq",
      "name": "Packager: packaging batch + outbound shipment",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/packager/products/vc/packaged-batch-001.jsonld",
          "${OD_CSS0_BASE_URL}/packager/shipments/out/vc/shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "104",
      "queryGroupId": "retailer",
      "queryLocation": "shipments.rq",
      "name": "Retailer: inbound receipt",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/retailer/shipments/in/vc/receipt-shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "105",
      "queryGroupId": "retailer",
      "queryLocation": "batch-provenance.rq",
      "name": "Retailer: batch transportation provenance",
      "description": "Finds both shipment legs and transport events for packaged batch 001.",
      "sourcesIndex": {
        "url": "${OD_CSS0_BASE_URL}/consortium/catalog/index.jsonld",
        "queryLocation": "sourceQueries/seeAlso.rq"
      }
    }
  ]
}
