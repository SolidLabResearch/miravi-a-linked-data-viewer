        "lenient": true
      }
    },
    {
      "id": "101",
      "queryGroupId": "farmer",
      "queryLocation": "shipments.rq",
      "name": "Farmer: shipments & product facts",
      "comunicaContext": {
        "sources": [
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment1.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/shipments/out/vc/shipment2.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-x.jsonld",
          "${OD_CSS0_BASE_URL}/farmer/products/vc/product-y.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "102",
      "queryGroupId": "transporter",
      "queryLocation": "shipments.rq",
