    {
      "id": "104",
      "queryGroupId": "retailer",
      "queryLocation": "shipments.rq",
      "name": "Retailer: inbound receipt",
      "comunicaContext": {
        "sources": [
          "${OD_CSS3_BASE_URL}/retailer/shipments/in/vc/receipt-shipment3.jsonld"
