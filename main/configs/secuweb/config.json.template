      "comunicaContext": {
        "sources": [
          "${OD_CSS2_BASE_URL}/transporter/transport-events/vc/pickup-shipment1.jsonld",
          "${OD_CSS2_BASE_URL}/transporter/transport-events/vc/delivery-shipment1.jsonld",
