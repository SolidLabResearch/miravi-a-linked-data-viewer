{
  "title": "Query the SecuWeb Food Supply Chain",
  "logoLocation": "images/IDLab-logo.png",
  "logoRedirectURL": "https://idlab.technology/",
  "mainAppColor": "lightgray",
  "backgroundColor": "#fff",
  "titleColor": "black",
  "textColor": "#1976D2",
  "queryFolder": "queries",
  "showMilliseconds": false,
  "defaultIDP": "/",
  "footer": "<p><a href='https://idlab.technology/'>IDLab</a> - <a href='https://www.imec.be/nl'>imec</a> - <a href='https://www.ugent.be/'>UGent</a></p>",
  "introductionText": "Please log in as the appropriate actor and select a query from the menu on the left.",
  "features": {
    "verification": {
      "vc": true,
      "onchain": true
    }
  },

  "queryGroups": [
    {
      "id": "farmer",
      "name": "Farmer",
      "icon": "InfoIcon"
    },
    {
      "id": "transporter",
      "name": "Transporter",
      "icon": "LocalShippingIcon"
    },
    {
      "id": "packager",
      "name": "Packager",
      "icon": "Inventory2Icon"
    },
    {
      "id": "retailer",
      "name": "Retailer",
      "icon": "StorefrontIcon"
    }
  ],
  "queries": [
    {
      "id": "0",
      "queryLocation": "spo.rq",
      "name": "SPO (all actors)",
      "comunicaContext": {
        "sources": [
          "http://localhost:3000/farmer/shipments/out/vc/shipment1.jsonld",
          "http://localhost:3000/farmer/shipments/out/vc/shipment2.jsonld",
          "http://localhost:3000/farmer/products/vc/product-x.jsonld",
          "http://localhost:3000/farmer/products/vc/product-y.jsonld",
          "http://localhost:3000/packager/products/vc/packaged-batch-001.jsonld",
          "http://localhost:3000/packager/shipments/out/vc/shipment3.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/pickup-shipment1.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/delivery-shipment1.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/pickup-shipment3.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/delivery-shipment3.jsonld",
          "http://localhost:3000/retailer/shipments/in/vc/receipt-shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "1",
      "queryLocation": "products.rq",
      "name": "Products (Farmer + Packager)",
      "comunicaContext": {
        "sources": [
          "http://localhost:3000/farmer/products/vc/product-x.jsonld",
          "http://localhost:3000/farmer/products/vc/product-y.jsonld",
          "http://localhost:3000/packager/products/vc/packaged-batch-001.jsonld",
          "http://localhost:3000/packager/shipments/out/vc/shipment3.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "101",
      "queryGroupId": "farmer",
      "queryLocation": "shipments.rq",
      "name": "Farmer: shipments & product facts",
      "comunicaContext": {
        "sources": [
          "http://localhost:3000/farmer/shipments/out/vc/shipment1.jsonld",
          "http://localhost:3000/farmer/shipments/out/vc/shipment2.jsonld",
          "http://localhost:3000/farmer/products/vc/product-x.jsonld",
          "http://localhost:3000/farmer/products/vc/product-y.jsonld"
        ],
        "lenient": true
      }
    },
    {
      "id": "102",
      "queryGroupId": "transporter",
      "queryLocation": "shipments.rq",
      "name": "Transporter: transport events",
      "comunicaContext": {
        "sources": [
          "http://localhost:3000/transporter/transport-events/vc/pickup-shipment1.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/delivery-shipment1.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/pickup-shipment3.jsonld",
          "http://localhost:3000/transporter/transport-events/vc/delivery-shipment3.jsonld"
